# Copy this file to `.env.docker` and fill in the marked values.
# Compose reads it via `env_file:` in docker-compose.yml.
#
#   cp .env.docker.example .env.docker
#   docker compose up --build

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=dev-only-do-not-use-this-key-in-production

# ── Database ────────────────────────────────────────────────────────────────
# Hostname `db` matches the service name in docker-compose.yml.
# DATABASE_URL is the canonical URL used by LangGraph + Django (in prod path).
DATABASE_URL=postgresql://postgres:postgres@db:5432/agent_sql
POSTGRES_DB=agent_sql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── API keys (REQUIRED — fill these in) ─────────────────────────────────────
# Groq:  https://console.groq.com
# Gemini (used for memory embeddings): https://aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Admin auto-provisioning ─────────────────────────────────────────────────
# Created by `python manage.py create_admin` on first container start.
# Safe to keep — idempotent (skips if user already exists).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ── Frontend / CORS (only matters when DEBUG=False) ─────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ── Email (optional — only needed for password-reset / signup verification) ─
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@agent.com
