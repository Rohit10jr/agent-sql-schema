# Auto-detect text files; commit with LF; check out as native on Windows
* text=auto eol=lf

# Python and config — always LF
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Windows-only scripts — keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binaries — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.gz binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.pyc binary
